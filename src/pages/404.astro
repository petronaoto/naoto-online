---
import Base from '../layouts/Base.astro';
---
<Base lang="ja" title="404">
  <section class="nf wrap">
    <p class="num big">404</p>
    <h1>ページが見つかりません <span lang="en">/ Page not found</span></h1>
    <p><a href="/">トップへ</a> · <a href="/en/" lang="en">Home</a></p>
  </section>
</Base>
<style>
  .nf { padding-block: 96px; display: grid; gap: 12px; }
  .big { font-size: clamp(5rem, 18vw, 10rem); font-weight: 900; line-height: 0.9; color: var(--accent); }
  h1 { font-size: 1.4rem; }
  h1 span { color: var(--rock); font-weight: 400; }
</style>

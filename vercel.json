{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/template.html", "destination": "/", "permanent": true },
    { "source": "/2008canada/top.htm", "destination": "/2008canada/", "permanent": true },
    { "source": "/2009hokkaido/hokkaidotop.htm", "destination": "/2009hokkaido/", "permanent": true },
    { "source": "/2010canada/2010canadatop.htm", "destination": "/2010canada/", "permanent": true },
    { "source": "/2010indonesia/indonesiatop.htm", "destination": "/2010indonesia/", "permanent": true },
    { "source": "/:trip(2008canada|2009hokkaido|2010canada|2010indonesia)/:page([\\w-]+).htm", "destination": "/:trip/:page/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/media/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    }
  ]
}

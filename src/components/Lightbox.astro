---
/** ページ内の写真（a.zoom）を全画面ビューアで開けるようにする */
---

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  const lightbox = new PhotoSwipeLightbox({
    gallery: 'main',
    children: 'a.zoom',
    pswpModule: () => import('photoswipe'),
    bgOpacity: 0.94,
    showHideAnimationType: 'fade',
  });
  lightbox.on('uiRegister', () => {
    lightbox.pswp?.ui?.registerElement({
      name: 'caption',
      order: 9,
      isButton: false,
      appendTo: 'root',
      onInit: (el, pswp) => {
        pswp.on('change', () => {
          const a = pswp.currSlide?.data.element as HTMLElement | undefined;
          el.textContent = a?.dataset.caption ?? '';
        });
      },
    });
  });
  lightbox.init();
</script>

<style is:global>
  .pswp__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 16px var(--gutter) calc(20px + env(safe-area-inset-bottom, 0px));
    color: #e8ecee;
    font-size: 0.85rem;
    text-align: center;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.6));
  }
  .pswp__caption:empty {
    display: none;
  }
</style>

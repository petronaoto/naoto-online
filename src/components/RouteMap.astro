---
/**
 * 走行ルートの地図（MapLibre GL + OpenFreeMap）。
 * 画面に入ってから地図ライブラリを読み込む。友人と走った区間は実線、単独区間は破線。
 */
import route from '../data/alps/route.json';
import places from '../data/alps/places.json';
import { href, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
// 縮小表示では重なるので、拡大したときだけ名前を出す地点
const MINOR = ['Passo Gardena', 'Passo Campolongo', 'Passo Pordoi', 'Passo Sella', 'Passo di Foscagno', 'Vipiteno'];
// 右側のラベルが他と重なる地点は左に出す
const LEFT = ['Livigno', 'Neuschwanstein'];
const data = JSON.stringify({
  route,
  places: [
    ...(places as any[])
      .filter((p) => p.kind !== 'town' || p.en === 'Munich')
      .map((p) => ({ n: lang === 'ja' ? p.ja : p.en, lon: p.lon, lat: p.lat, kind: p.kind, ele: p.ele, minor: MINOR.includes(p.en), left: LEFT.includes(p.en) })),
    { n: lang === 'ja' ? 'セラロンダ 4峠' : 'Sella Ronda · 4 passes', lon: 11.83, lat: 46.53, kind: 'group', ele: 0, minor: false, left: false },
  ],
  days: [1, 2, 3, 4, 5].map((d) => href(lang, `/2026alps/day${d}/`)),
  lang,
});
---

<figure class="routemap" data-map={data}>
  <div class="canvas" role="img" aria-label={lang === 'ja' ? 'ミュンヘン発着、アルプス周回ルートの地図' : 'Map of the loop through the Alps from Munich'}>
    <noscript>{lang === 'ja' ? '地図の表示には JavaScript が必要です。' : 'The map requires JavaScript.'}</noscript>
  </div>
  <figcaption>
    <span><i class="sw solid"></i>{lang === 'ja' ? '友人と（Day1–3）' : 'Together (Day 1–3)'}</span>
    <span><i class="sw dash"></i>{lang === 'ja' ? '単独（Day4–5）' : 'Solo (Day 4–5)'}</span>
    <span class="credit">© OpenFreeMap © OpenMapTiles © OpenStreetMap contributors</span>
  </figcaption>
</figure>

<script>
  import type { Map as MLMap } from 'maplibre-gl';
  import workerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url';

  const fig = document.querySelector<HTMLElement>('figure.routemap');
  if (fig) {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          init(fig);
        }
      },
      { rootMargin: '300px' },
    );
    io.observe(fig);
  }

  async function init(fig: HTMLElement) {
    const [ml] = await Promise.all([import('maplibre-gl'), import('maplibre-gl/dist/maplibre-gl.css')]);
    const maplibregl: typeof import('maplibre-gl') = (ml as any).default ?? ml;
    // v6 は Worker を import.meta.url 基準で探すため、Vite でまとめた Worker の URL を明示する
    maplibregl.setWorkerUrl(workerUrl);
    const d = JSON.parse(fig.dataset.map!);
    const dark = () =>
      document.documentElement.dataset.theme === 'dark' ||
      (!document.documentElement.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
    const style = () => `https://tiles.openfreemap.org/styles/${dark() ? 'dark' : 'positron'}`;
    const accent = () => getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#7a4527';
    const ink = () => getComputedStyle(document.documentElement).getPropertyValue('--ink').trim() || '#14181b';

    const map: MLMap = new maplibregl.Map({
      container: fig.querySelector<HTMLElement>('.canvas')!,
      style: style(),
      bounds: [
        [10.0, 46.4],
        [12.0, 48.3],
      ],
      fitBoundsOptions: { padding: 24 },
      attributionControl: false,
      cooperativeGestures: true,
      locale: d.lang === 'ja' ? { 'CooperativeGesturesHandler.WindowsHelpText': 'Ctrl キーを押しながらスクロールで拡大縮小', 'CooperativeGesturesHandler.MacHelpText': '⌘ キーを押しながらスクロールで拡大縮小', 'CooperativeGesturesHandler.MobileHelpText': '2本指で地図を動かします' } : {},
    });
    map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');

    const addLayers = () => {
      const features = d.route.map((r: any) => ({
        type: 'Feature',
        properties: { day: r.day, solo: r.day >= 4 },
        geometry: { type: 'LineString', coordinates: r.coords },
      }));
      if (map.getSource('route')) return;
      map.addSource('route', { type: 'geojson', data: { type: 'FeatureCollection', features } });
      map.addLayer({ id: 'route-casing', type: 'line', source: 'route', paint: { 'line-color': dark() ? '#0d1012' : '#ffffff', 'line-width': 7 }, layout: { 'line-join': 'round', 'line-cap': 'round' } });
      map.addLayer({ id: 'route-together', type: 'line', source: 'route', filter: ['==', ['get', 'solo'], false], paint: { 'line-color': accent(), 'line-width': 4 }, layout: { 'line-join': 'round', 'line-cap': 'round' } });
      map.addLayer({ id: 'route-solo', type: 'line', source: 'route', filter: ['==', ['get', 'solo'], true], paint: { 'line-color': ink(), 'line-width': 3, 'line-dasharray': [2, 1.6] }, layout: { 'line-join': 'round' } });
      map.addLayer({ id: 'route-hit', type: 'line', source: 'route', paint: { 'line-color': '#000', 'line-opacity': 0, 'line-width': 18 } });
      map.on('mouseenter', 'route-hit', () => (map.getCanvas().style.cursor = 'pointer'));
      map.on('mouseleave', 'route-hit', () => (map.getCanvas().style.cursor = ''));
      map.on('click', 'route-hit', (e) => {
        const day = e.features?.[0]?.properties?.day;
        if (day) location.href = d.days[day - 1];
      });
    };
    // 日本語ページでは地図の地名も日本語（なければ現地表記）にする
    const localize = () => {
      if (d.lang !== 'ja') return;
      for (const layer of map.getStyle().layers ?? []) {
        if (layer.type === 'symbol' && map.getLayoutProperty(layer.id, 'text-field')) {
          map.setLayoutProperty(layer.id, 'text-field', ['coalesce', ['get', 'name:ja'], ['get', 'name']]);
        }
      }
    };
    map.on('style.load', () => {
      addLayers();
      localize();
    });

    const pins: { el: HTMLElement; p: any }[] = [];
    for (const p of d.places) {
      const el = document.createElement('div');
      el.className = `pin ${p.kind}${p.minor ? ' minor' : ''}${p.left ? ' left' : ''}`;
      el.innerHTML = p.kind === 'group' ? `<span>${p.n}</span>` : `<i></i><span>${p.n}${p.kind === 'pass' ? `<small>${p.ele.toLocaleString()} m</small>` : ''}</span>`;
      const anchor = p.kind === 'group' ? 'top' : p.left ? 'right' : 'left';
      new maplibregl.Marker({ element: el, anchor, offset: p.kind === 'group' ? [0, 10] : [p.left ? 5 : -5, 0] }).setLngLat([p.lon, p.lat]).addTo(map);
      pins.push({ el, p });
    }
    // ズームに応じて、細かい地点の名前とまとめラベルを切り替える
    const zoomLabels = () => {
      const near = map.getZoom() >= 8.6;
      for (const { el, p } of pins) {
        if (p.minor) el.classList.toggle('hide-label', !near);
        if (p.kind === 'group') el.style.display = near ? 'none' : '';
      }
    };
    map.on('zoom', zoomLabels);
    zoomLabels();

    // テーマ切替に追従
    const obs = new MutationObserver(() => map.setStyle(style()));
    obs.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => map.setStyle(style()));
  }
</script>

<style>
  .routemap {
    margin: 0;
    display: grid;
    gap: 8px;
  }
  .canvas {
    height: clamp(380px, 62vh, 640px);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    font-size: 0.75rem;
    color: var(--rock);
    align-items: center;
  }
  figcaption span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .credit {
    margin-left: auto;
    font-size: 0.65rem;
  }
  .sw {
    display: inline-block;
    width: 22px;
    border-top: 3px solid var(--accent);
  }
  .sw.dash {
    border-top: 2px dashed var(--solo);
  }
  .routemap :global(.pin) {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-num), var(--font-ja);
    font-size: 11px;
    font-weight: 700;
    color: var(--ink);
    pointer-events: none;
    white-space: nowrap;
  }
  .routemap :global(.pin i) {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--ink);
    flex: none;
  }
  .routemap :global(.pin.pass i) {
    background: var(--sign);
    border-color: #fff;
    box-shadow: 0 0 0 1px var(--sign);
  }
  .routemap :global(.pin span) {
    background: color-mix(in srgb, var(--paper) 85%, transparent);
    padding: 1px 5px 0;
    border-radius: 2px;
    display: grid;
    line-height: 1.25;
  }
  .routemap :global(.pin small) {
    font-size: 9.5px;
    color: var(--rock);
  }
  .routemap :global(.pin.left) {
    flex-direction: row-reverse;
  }
  .routemap :global(.pin.hide-label span) {
    display: none;
  }
  .routemap :global(.pin.group span) {
    background: var(--sign);
    color: #fff;
    font-size: 10.5px;
  }
  .routemap :global(.pin.sight span),
  .routemap :global(.pin.stay span) {
    font-weight: 500;
  }
</style>
